---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const home = import.meta.env.BASE_URL;
---
<Base title="Page not found — Noémie Rakotomalala" noindex>
  <Nav hrefPrefix={home} />
  <main id="main" class="nf">
    <div class="container prose">
      <span class="eyebrow">404 / not found</span>
      <h1>This trail doesn't go anywhere</h1>
      <p>The page you're looking for has wandered off, probably after a marmot.</p>
      <p><a href={home}>Head back home</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 60vh;
    padding-block: 96px;
  }
  h1 {
    margin-bottom: 16px;
  }
</style>
