---
import Book from './Book.astro';
import { books } from '../data/books';
---
<div class="bookshelf" data-bookshelf>
  <ul class="shelf" role="list">
    {books.map((book, i) => <Book book={book} index={i} />)}
  </ul>
  <div class="shelf-board" aria-hidden="true"></div>
  <p class="hint mono">Hover, tap or press Enter on a book for details.</p>
  <div id="book-detail" class="book-detail" role="region" aria-live="polite" aria-label="Selected book" hidden data-detail>
    <p class="detail-title"></p>
    <p class="detail-author"></p>
    <p class="detail-note"></p>
    <a class="detail-link" href="#books" target="_blank" rel="noopener noreferrer" hidden>Find the book<span class="sr-only"> (opens in a new tab)</span></a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bookshelf]').forEach((shelf) => {
    const books = shelf.querySelectorAll<HTMLButtonElement>('[data-book]');
    const detail = shelf.querySelector<HTMLElement>('[data-detail]')!;
    const title = detail.querySelector<HTMLElement>('.detail-title')!;
    const author = detail.querySelector<HTMLElement>('.detail-author')!;
    const note = detail.querySelector<HTMLElement>('.detail-note')!;
    const link = detail.querySelector<HTMLAnchorElement>('.detail-link')!;
    let open: HTMLButtonElement | null = null;

    const close = () => {
      if (!open) return;
      open.setAttribute('aria-expanded', 'false');
      open.classList.remove('is-open');
      open = null;
      detail.hidden = true;
    };

    books.forEach((btn) =>
      btn.addEventListener('click', () => {
        if (open === btn) return close();
        close();
        open = btn;
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('is-open');
        const d = btn.dataset;
        title.textContent = d.title ?? '';
        author.textContent = `by ${d.author}`;
        note.textContent = d.note ?? '';
        note.hidden = !d.note;
        link.hidden = !d.url;
        if (d.url) link.href = d.url;
        detail.hidden = false;
      }),
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        const btn = open;
        close();
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (open && !shelf.contains(e.target as Node)) close();
    });
  });
</script>

<style>
  .bookshelf {
    --w: 130px;
    --h: 195px;
    --t: 30px;
    position: relative;
  }
  .shelf {
    display: flex;
    gap: 26px;
    padding: 28px 24px 4px;
    margin: 0 -16px;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 24px;
    scrollbar-width: thin;
    perspective: 1200px;
  }
  .shelf :global(.book-item) {
    flex: none;
    scroll-snap-align: start;
  }
  .shelf-board {
    height: 10px;
    margin: 0 -8px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--border), transparent);
    border-top: 1px solid color-mix(in srgb, var(--text) 18%, var(--border));
    box-shadow: 0 14px 22px -14px rgb(0 0 0 / 0.5);
  }

  /* ----- The book button ----- */
  .shelf :global(.book) {
    display: block;
    width: var(--w);
    height: calc(var(--h) + 12px);
    padding: 0;
    padding-top: 12px;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 4px;
    perspective: 700px;
  }
  .shelf :global(.book-3d) {
    position: relative;
    display: block;
    width: var(--w);
    height: var(--h);
    transform-style: preserve-3d;
    transform: rotateY(32deg);
    transition: transform 0.35s var(--ease-out);
  }
  .shelf :global(.book-3d)::after {
    /* floor shadow */
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -6px;
    height: 12px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    filter: blur(6px);
    transform: translateZ(calc(var(--t) * -0.5)) rotateX(90deg);
    opacity: 0.6;
    transition: opacity 0.35s, transform 0.35s var(--ease-out);
  }
  .shelf :global(.book:hover .book-3d),
  .shelf :global(.book:focus-visible .book-3d),
  .shelf :global(.book.is-open .book-3d) {
    transform: translateY(-8px) rotateY(0deg);
  }
  .shelf :global(.book:hover .face.front),
  .shelf :global(.book:focus-visible .face.front),
  .shelf :global(.book.is-open .face.front) {
    box-shadow: 0 18px 30px -8px rgb(0 0 0 / 0.55);
  }
  .shelf :global(.book.is-open .face.front) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .shelf :global(.face) {
    position: absolute;
    top: 0;
    display: block;
    height: var(--h);
    backface-visibility: hidden;
  }
  .shelf :global(.front) {
    left: 0;
    width: var(--w);
    border-radius: 2px 4px 4px 2px;
    overflow: hidden;
    background: var(--book-color);
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.5);
    transition: box-shadow 0.35s var(--ease-out);
  }
  .shelf :global(.front)::before {
    /* binding crease + sheen */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.28) 0,
      rgb(255 255 255 / 0.12) 4px,
      rgb(0 0 0 / 0.12) 9px,
      transparent 14px,
      transparent 70%,
      rgb(255 255 255 / 0.08) 100%
    );
  }
  .shelf :global(.spine) {
    left: 0;
    width: var(--t);
    transform-origin: left center;
    transform: translateZ(calc(var(--t) * -1)) rotateY(-90deg);
    background: linear-gradient(to right, color-mix(in srgb, var(--book-color) 70%, #000), var(--book-color) 40%, color-mix(in srgb, var(--book-color) 80%, #000));
    color: rgb(255 255 255 / 0.92);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .shelf :global(.spine span) {
    writing-mode: vertical-rl;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    max-height: calc(var(--h) - 20px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .shelf :global(.pages) {
    right: 0;
    top: 3px;
    height: calc(var(--h) - 6px);
    width: calc(var(--t) - 2px);
    transform-origin: right center;
    transform: translateZ(calc(var(--t) * -1)) rotateY(90deg);
    background: repeating-linear-gradient(to right, #f3efe4 0 2px, #d9d3c3 2px 3px);
  }
  .shelf :global(.back) {
    left: 0;
    width: var(--w);
    transform: translateZ(calc(var(--t) * -1)) rotateY(180deg);
    background: color-mix(in srgb, var(--book-color) 80%, #000);
    border-radius: 4px 2px 2px 4px;
  }

  .shelf :global(.cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shelf :global(.gen-cover) {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 18px 12px 14px 20px;
    text-align: left;
    color: #fff;
    background:
      radial-gradient(circle at 85% 12%, rgb(255 255 255 / 0.18), transparent 45%),
      var(--book-color);
  }
  .shelf :global(.gen-rule) {
    width: 28px;
    height: 2px;
    margin-bottom: 12px;
    background: rgb(255 255 255 / 0.75);
  }
  .shelf :global(.gen-title) {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }
  .shelf :global(.gen-author) {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.3;
    opacity: 0.88;
  }

  .hint {
    margin-top: 14px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .book-detail {
    margin-top: 16px;
    padding: 16px 20px;
    max-width: var(--prose);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 8px;
  }
  .detail-title {
    font-weight: 600;
  }
  .book-detail p + p {
    margin-top: 2px;
  }
  .detail-author {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .detail-note {
    margin-top: 8px !important;
  }
  .detail-link {
    display: inline-block;
    margin-top: 8px;
  }

  /* ----- Reduced motion: flat grid, no transforms ----- */
  @media (prefers-reduced-motion: reduce) {
    .shelf {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(var(--w), 1fr));
      gap: 20px;
      margin: 0;
      padding: 0;
      overflow: visible;
      perspective: none;
    }
    .shelf :global(.book) {
      perspective: none;
      padding-top: 0;
      height: var(--h);
    }
    .shelf :global(.book-3d),
    .shelf :global(.book:hover .book-3d),
    .shelf :global(.book:focus-visible .book-3d),
    .shelf :global(.book.is-open .book-3d) {
      transform: none;
      transition: none;
    }
    .shelf :global(.book-3d)::after,
    .shelf :global(.spine),
    .shelf :global(.pages),
    .shelf :global(.back) {
      display: none;
    }
    .shelf :global(.front) {
      transition: none;
    }
    .shelf-board {
      display: none;
    }
  }
</style>
