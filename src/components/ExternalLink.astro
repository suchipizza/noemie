---
// Link that opens in a new tab and says so (icon + visually hidden text).
// The last word and the icon are kept together so the icon never wraps alone.
import Icon from './Icon.astro';
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const html = (await Astro.slots.render('default')).trim();
const split = html.match(/^([\s\S]*?)(\S+)$/);
const [head, last] = split ? [split[1], split[2]] : ['', html];
---
<a href={href} class={className} target="_blank" rel="noopener noreferrer"><Fragment set:html={head} /><span class="nowrap"><Fragment set:html={last} /><Icon name="external" class="ext-icon" size={12} /></span><span class="sr-only"> (opens in a new tab)</span></a>
