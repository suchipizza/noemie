---
import ThemeToggle from './ThemeToggle.astro';
interface Props {
  /** Prefix for anchors, e.g. the home URL on the 404 page. */
  hrefPrefix?: string;
}
const { hrefPrefix = '' } = Astro.props;
const items = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'books', label: 'Books' },
  { id: 'contact', label: 'Contact' },
];
const home = import.meta.env.BASE_URL;
---
<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a class="brand mono" href={home} aria-label="Noémie, home">noémie<span aria-hidden="true">_</span></a>
    <ul class="nav-links" role="list">
      {items.map((i) => (
        <li><a href={`${hrefPrefix}#${i.id}`} data-nav={i.id}>{i.label}</a></li>
      ))}
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    flex: none;
  }
  .brand span {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-left: auto;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    min-width: 0;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-links a {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .nav-links a[aria-current='true'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  @media (max-width: 640px) {
    .brand {
      display: none;
    }
    .nav {
      gap: 8px;
    }
    .nav-links {
      margin-left: -6px;
      margin-right: auto;
      /* hint that the row scrolls */
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .nav-links a {
      padding: 6px 8px;
      font-size: 0.9rem;
    }
  }
</style>
